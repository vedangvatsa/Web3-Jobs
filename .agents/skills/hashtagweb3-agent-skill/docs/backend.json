{
  "entities": {
    "Subscriber": {
      "title": "Subscriber",
      "description": "A user who has subscribed to email updates.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "The subscriber's email address."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the subscription was created."
        }
      },
      "required": [
        "email",
        "createdAt"
      ]
    }
  },
  "auth": {
    "providers": []
  },
  "firestore": {
    "/subscribers/{subscriberId}": {
      "schema": {
        "$ref": "#/backend/entities/Subscriber"
      },
      "description": "Collection of email subscribers."
    }
  }
}
