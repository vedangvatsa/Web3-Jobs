# PostHog Analytics (Public - safe to expose)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Firebase Configuration (Public keys - safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_bucket.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Private/Backend secrets (NEVER commit - add to .env.local ONLY)
# Email Service (Resend)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="alerts@hashtagweb3.com"
EMAIL_FROM_NAME="Hashtag Web3"
EMAIL_REPLY_TO="support@hashtagweb3.com"
EMAIL_UNSUBSCRIBE_URL="https://hashtagweb3.com/unsubscribe"

# Authentication & Security
CRON_SECRET=your_strong_random_secret_here

# ⚠️ SECURITY REMINDER:
# 1. All RESEND_API_KEY and CRON_SECRET must be in .env.local
# 2. Never commit .env.local or .env.*.local files
# 3. Keep backups of these secrets in secure location
# 4. Rotate secrets regularly in production
# 5. All .env* files are in .gitignore for protection
