FROM node:24-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

ENV CF_CONTAINER_BUILD=1 \
    FAH_FAST_PREBUILD=1 \
    OG_PRECOMPUTE=0 \
    OG_FILL_MISSING=1 \
    NODE_OPTIONS=--max-old-space-size=3072 \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=8080 \
    HOSTNAME=0.0.0.0 \
    NODE_ENV=production

# Do not use `npm run build` — npm runs the `prebuild` lifecycle first, which rewrites
# job-description-shards (EXDEV on Docker overlay FS).
RUN npx tsx scripts/cloudflare-container-prep.ts \
  && npx tsx scripts/run-production-build.ts

EXPOSE 8080
CMD ["node", ".next/standalone/server.js"]
