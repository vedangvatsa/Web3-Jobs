  "policies": [
    {
      "passports": [
        "BE"
      ],
      "destinations": [
        "CG"
      ],
      "t": "vr",
      "d": 0,
      "s": "gap5-04-cg-be",
      "n": "Belgian passport: a visa must be requested before departure at the Republic of Congo embassy in Brussels. This establishes the visa requirement for Belgian visitors; no tourist stay or independent electronic-issuance entitlement is established.",
      "label": "Visa required; stay unspecified"
    },
    {
      "passports": [
        "ES"
      ],
      "destinations": [
        "CG"
      ],
      "t": "vr",
      "d": 0,
      "s": "gap5-04-cg-es",
      "n": "Spanish passport: obtaining a visa before travel is mandatory. Spanish Foreign Affairs directs applications to the Republic of Congo embassy in Paris. Tourist stay and electronic-issuance eligibility are not specified. This is the Republic of Congo rule, not the separate Democratic Republic of Congo requirement.",
      "label": "Visa required; stay unspecified"
    },
    {
      "passports": [
        "IT"
      ],
      "destinations": [
        "CG"
      ],
      "t": "vr",
      "d": 0,
      "s": "gap5-04-cg-it",
      "n": "Italian passport: entry visa required, requested from the Republic of Congo consular office in Rome. Passport must remain valid for at least six months at departure; carry return/onward travel, validated host accommodation evidence or a hotel reservation, and yellow-fever vaccination certificate. Tourist stay and independent electronic issuance are not established.",
      "label": "Visa required; stay unspecified"
    },
    {
      "passports": [
        "PT"
      ],
      "destinations": [
        "CG"
      ],
      "t": "vr",
      "d": 0,
      "s": "gap5-04-cg-pt",
      "n": "Portuguese passport: obtain a visa in advance from a Republic of Congo embassy or consulate. Portuguese guidance says it cannot be obtained on entry; this is origin-specific guidance, not a worldwide denial of arrival mechanisms. Passport must be valid for at least six months from arrival. Tourist stay and independent electronic issuance are not established.",
      "label": "Visa required; stay unspecified"
    },
    {
      "passports": [
        "RU"
      ],
      "destinations": [
        "CG"
      ],
      "t": "vr",
      "d": 0,
      "s": "gap5-04-cg-ru",
      "n": "Russian ordinary passport: a valid visa is required at the border. Russian MFA describes a passport sticker obtained from the Republic of Congo embassy and requires return travel, means for return and invitation or hotel evidence. Its 90-day exemption concerns diplomatic/service passports only. No ordinary tourist stay or independent electronic-issuance entitlement is established.",
      "label": "Visa required; stay unspecified"
    },
    {
      "passports": [
        "RU"
      ],
      "destinations": [
        "YE"
      ],
      "t": "vr",
      "d": 0,
      "s": "gap5-04-ye-ru",
      "n": "Russian ordinary passport: visa required before entry. The Russian MFA page establishes the requirement, but its embassy-only channel description is not used to exclude the later Aden IPNA agency-mediated tourist approval workflow. Current Russian-passport eligibility for that workflow, issuance channel and tourist stay remain unverified. No routine tourist issuance or permission throughout mainland Yemen or Socotra is assured; competent authority, entry port and territorial permissions require confirmation.",
      "label": "Visa required; issuance and territorial access unconfirmed",
      "evidence": [
        "gap-08-ye-workflow"
      ]
    }
  ],
