        "gap4-04-iq-federal-law"
      ]
    },
    {
      "passports": [
        "MY"
      ],
      "destinations": [
        "IQ"
      ],
      "t": "vr",
      "d": 0,
      "s": "gap5-05-iq-my",
      "label": "Visa required; arrival/eVisa channel qualified",
      "n": "Visa duty is established. The Kuala Lumpur mission notice of 21 January 2025 permits Malaysian Visit visas at airport and land entry points from 11 September 2024; it does not announce visa freedom or specify a stay. Later/current general mission instructions direct foreign-passport applicants to the federal eVisa portal, so this record does not promise operational walk-up issuance or universal electronic eligibility. Confirm the applicable channel before travel. Kurdistan permission is separate.",
      "evidence": [
        "gap4-04-iq-federal-law"
      ]
    },
    {
      "passports": [
        "PS",
        "XK"
      ],
      "destinations": [
        "KR"
      ],
      "t": "vr",
      "d": 0,
      "s": "gap5-05-kr-checker",
      "label": "Tourist visa required; mission assessment",
      "n": "The public nationality-specific navigator returns C-3-9 Ordinary Tourist with an overseas-mission process for holiday/leisure travel. A valid acceptable passport and visa are required. Single-entry and double-entry stays differ; issuance remains subject to document and consular assessment. HiKorea expressly excludes these nationalities from the direct-Jeju and specified transit visa waivers. The navigator’s older Palestine transit text is not used as current permission. An electronic application form is not an eVisa.",
      "stay": "C-3-9: up to 90 days for a single-entry visa; 30 days for a double-entry visa"
    },
    {
      "passports": [
        "SS",
        "TL"
      ],
      "destinations": [
        "BZ"
      ],
      "t": "vr",
      "d": 0,
      "s": "gap5-05-bz-law",
      "label": "Visa required; conditional exemptions",
      "n": "The official Immigration Regulations impose a visitor visa requirement outside specified exemptions. Neither South Sudan nor Timor-Leste has a nationality exemption in the reviewed regulations, later immigration instruments or current schedule. No third-country document, same-vessel cruise visit or qualifying transit is assumed. Qualifying US/Canadian visa or permanent-resident documents and Schengen documents can change the requirement; the current page and older Schengen instruments differ on scope/stay. Standard visa guidance states a maximum 30-day initial visit, but conditional branches and the actual grant must be checked."
    },
    {
      "passports": [
        "RU"
      ],
      "destinations": [
        "LT"
      ],
      "t": "vr",
      "d": 0,
      "s": "gap5-05-lt-restrictions",
      "label": "Visa and document restrictions; tourism unconfirmed",
      "n": "Visa required, with restricted processing: Lithuania suspends Russian-national Schengen visa applications except where mediated by its Foreign Ministry. The EU recognition matrix records non-recognition of Russian non-biometric ordinary passports; territorial issuance restrictions also apply. Russian nationals crossing the external EU border into Lithuania face additional individual screening. This is a qualified duty/document-restriction record: it does not establish a routine tourist issuance route, eligibility for an exception, or permission to enter via either an external or internal Schengen route. Stay is unconfirmed.",
      "evidence": [
        "europe-schengen-common"
      ]
    }
