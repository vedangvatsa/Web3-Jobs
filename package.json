    "linkedin:post-jobs": "npx tsx scripts/linkedin-auto-post.ts",
    "linkedin:authorize": "echo 'Visit the LinkedIn OAuth URL to authorize'",
    "check:slop": "node scripts/check-slop.js",
    "check:quality": "npx tsx scripts/audit-site-quality.ts",
    "audit:articles": "npx tsx scripts/audit-article-quality.ts --report",
    "audit:article-markdown": "npx tsx scripts/audit-article-markdown.ts",
    "test:article-markdown": "npx tsx scripts/test-article-markdown.ts",
    "repair:article-markdown": "npx tsx scripts/repair-article-markdown.ts",
    "check:articles": "npx tsx scripts/audit-article-quality.ts",
    "fix:articles:formatting": "npx tsx scripts/normalize-article-source-formatting.ts",
    "fix:articles:editorial": "npx tsx scripts/normalize-article-editorial-language.ts",
    "images:unsplash": "npx tsx scripts/assign-unsplash-article-images.ts",
    "images:commons": "npx tsx scripts/assign-commons-article-images.ts",
    "jobs:backfill-lever-salaries": "npx tsx scripts/backfill-lever-salaries.ts",
    "check:logos": "node scripts/check-logo-case.js",
    "clean:slop": "node scripts/clean-slop.js --apply",
    "ingest:paradigm": "npx tsx scripts/ingest-paradigm.ts",
