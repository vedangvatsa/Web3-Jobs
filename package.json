    "recover:event-sources": "tsx scripts/recover-event-source-gaps.ts",
    "test:event-source-recovery": "tsx scripts/test-event-source-recovery.ts",
    "test:job-slugs": "npx tsx scripts/test-job-slug-reserved.ts",
