    "build:cloudflare": "env -u CLOUDFLARE_API_KEY -u CLOUDFLARE_EMAIL opennextjs-cloudflare build",
    "deploy:cloudflare": "env -u CLOUDFLARE_API_KEY -u CLOUDFLARE_EMAIL opennextjs-cloudflare build && env -u CLOUDFLARE_API_KEY -u CLOUDFLARE_EMAIL opennextjs-cloudflare deploy",
    "postbuild": "tsx scripts/copy-standalone-catalogs.ts && tsx scripts/test-prerender-budget.ts",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "cli": "node packages/cli/bin/hashtagweb3.js",
    "export:emails": "npx tsx scripts/export-emails.ts",
    "send-alerts": "npx tsx scripts/send-resend-broadcast.ts",
    "send-new-jobs": "npx tsx scripts/send-new-jobs.ts",
