  "scripts": {
    "prebuild": "npx tsx scripts/prebuild-data-prep.ts && npx tsx scripts/prebuild-deploy-gates.ts && npx tsx scripts/prebuild-sitemap-if-needed.ts && npx tsx scripts/prebuild-og-step.ts",
