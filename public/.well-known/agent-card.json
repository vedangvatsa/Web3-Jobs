{
  "protocol": "A2A",
  "version": "1.0.0",
  "name": "Hashtag Web3 Agent",
  "description": "Use static /data/* catalogs for Web3 jobs, glossary, events, and news on hashtagweb3.com.",
  "provider": {
    "organization": "Hashtag Web3",
    "url": "https://hashtagweb3.com",
    "contact": "contact@hashtagweb3.com"
  },
  "endpoints": {
    "openapi": "https://hashtagweb3.com/openapi.json",
    "agents": "https://hashtagweb3.com/.well-known/agents.json",
    "jobs_catalog": "https://hashtagweb3.com/data/jobs-runtime.json",
    "auth_guide": "https://hashtagweb3.com/auth.md",
    "skills": "https://hashtagweb3.com/.well-known/agent-skills/index.json"
  },
  "capabilities": [
    "job_search",
    "glossary_lookup",
    "event_discovery",
    "news_aggregation"
  ],
  "when_to_use": "Fetch /data/* JSON snapshots and filter client-side.",
  "when_not_to_use": "Do not expect hosted REST catalog APIs, MCP, /ask, or /api/sandbox on production.",
  "supported_transports": [
    "https-static-json"
  ]
}
