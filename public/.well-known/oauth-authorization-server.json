{
  "issuer": "https://hashtagweb3.com",
  "authorization_endpoint": "https://hashtagweb3.com/api/auth",
  "token_endpoint": "https://hashtagweb3.com/api/auth/claim",
  "revocation_endpoint": "https://hashtagweb3.com/api/auth/revoke",
  "registration_endpoint": "https://hashtagweb3.com/api/auth/register",
  "response_types_supported": ["token", "code"],
