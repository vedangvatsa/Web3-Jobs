{
  "openapi": "3.1.0",
  "info": {
    "title": "Hashtag Web3 static catalogs",
    "version": "1.1.0",
    "description": "Human website first. Machine-readable data is served as static JSON under /data/ (CDN). No hosted MCP or public REST search API."
  },
  "servers": [
    { "url": "https://hashtagweb3.com" }
  ],
  "paths": {
    "/data/jobs-runtime.json": {
      "get": {
        "summary": "Jobs catalog snapshot",
        "responses": { "200": { "description": "JSON array of jobs (no descriptions)" } }
      }
    },
    "/data/events-runtime.json": {
      "get": {
        "summary": "Events catalog snapshot",
        "responses": { "200": { "description": "JSON events catalog" } }
      }
    },
    "/data/glossary-runtime.json": {
      "get": {
        "summary": "Glossary catalog snapshot",
        "responses": { "200": { "description": "JSON glossary catalog" } }
      }
    },
    "/data/news-cache.json": {
      "get": {
        "summary": "News headlines cache",
        "responses": { "200": { "description": "JSON news cache" } }
      }
    },
    "/agent-view.json": {
      "get": {
        "summary": "Agent capability index",
        "responses": { "200": { "description": "Static agent overview JSON" } }
      }
    }
  }
}
