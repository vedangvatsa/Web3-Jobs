{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hashtagweb3",
  "main": ".open-next/worker.js",
  "account_id": "98dc3d9d6a9efe3231032ff064ac0a01",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hashtagweb3"
    }
  ],
  "routes": [
    { "pattern": "hashtagweb3.com", "zone_name": "hashtagweb3.com", "custom_domain": true },
    { "pattern": "www.hashtagweb3.com", "zone_name": "hashtagweb3.com", "custom_domain": true }
  ]
}
