{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hashtagweb3",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "HASHTAGWEB3_CLOUDFLARE": "1",
    "NEXT_PUBLIC_SITE_URL": "https://hashtagweb3.vatsvedang.workers.dev",
    "NEXT_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
    "NEXT_PUBLIC_POSTHOG_KEY": "phc_KjSiNbbK5PNCGDgs2s7kYefJ2kwoSNR0JjLKFg6CuRj",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "web3-jobs-aggregator"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hashtagweb3"
    }
  ]
}